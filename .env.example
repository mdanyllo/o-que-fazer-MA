# Copie para .env.local e preencha (Supabase → Project Settings → API).
# Só valores públicos aqui: a anon key é feita para ir ao navegador; quem protege os dados é a RLS.
# NUNCA coloque a service_role key em variáveis VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Plano Pro: só para as funções do servidor e os testes (README, seção 6). NUNCA com prefixo VITE_.
# ASAAS_API_KEY=
# ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# ASAAS_WEBHOOK_TOKEN=
